# Golden/corpus files are compared byte-for-byte; a CRLF checkout (the default
# git setting on Windows runners) would break every fixture. Keep LF everywhere.
* text=auto eol=lf
*.gif binary
*.png binary
# cmd.exe batch files misparse LF-only line endings in some constructs.
*.cmd text eol=crlf
*.bat text eol=crlf
